{
  "manifest_version": 3,
  "name": "Wealthsimple Dark Mode",
  "version": "1.0",
  "description": "Dark mode for the web version of Wealthsimple, because it's taking them ages to implement this.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["scripting"],
  "host_permissions": ["https://my.wealthsimple.com/app/home"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://my.wealthsimple.com/app/home"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
